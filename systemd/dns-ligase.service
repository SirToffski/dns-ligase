[Unit]
Description=DNS Ligase - DNS forwarder with blocklist support
Documentation=https://github.com/SirToffski/dns-ligase
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple

# Execution
ExecStart=/usr/bin/dns-ligase --config /etc/dns-ligase/config.toml
Restart=on-failure
RestartSec=5

# Dynamic user: no useradd needed, StateDirectory created with correct ownership
DynamicUser=yes
StateDirectory=dns-ligase
WorkingDirectory=/var/lib/dns-ligase
Environment=HOME=/var/lib/dns-ligase

# If you need to listen on 53
# AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW

# Resource limits
MemoryMax=1G

# Logging (journald)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dns-ligase

# SIGHUP reload support
ExecReload=/bin/kill -HUP $MAINPID

# Security hardening
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
